# You do NOT create a .env file for Vercel — you type these two values into
# Vercel's website instead (Project -> Settings -> Environment Variables).
# This file only shows you what they look like.

# From Supabase -> Connect -> "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with the database password you chose.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# A long random password YOU invent. Every hydrogeologist's app needs it to
# read/write surveys. Letters and numbers, 24+ characters.
API_KEY=change-this-to-a-long-random-secret
